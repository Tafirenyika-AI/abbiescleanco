# Copy this file to .env.local for local development (never commit real secrets).
# Every integration below is optional at first run — the app uses safe mock
# adapters (logged to the console) for anything left unset, so the full
# customer journey (estimate -> lead -> confirmation email -> WhatsApp
# handoff) works before any credentials exist. See README.md.

# ---- Database (PostgreSQL / Supabase) ----
# Without this set, leads are stored in a local .data/leads.json mock file
# instead of Postgres. Required before deploying to production.
DATABASE_URL=

# ---- Email (Resend) ----
# Without this set, emails are logged to the server console instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Abbie's Clean Method <hello@abbiescleanco.com>"

# ---- SMS / WhatsApp Business notifications (Twilio) ----
# Without these set, messages are logged instead of sent. The customer-facing
# "Message Us on WhatsApp" button does NOT require these — it opens wa.me
# directly and needs no API credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Payments (Stripe) ----
# Required only once deposits/online payments are enabled (Phase 4).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Google Maps (service-area validation) ----
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---- Google Calendar (appointment sync, Phase 3) ----
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# ---- Bot protection (Cloudflare Turnstile) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Analytics ----
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# ---- Error reporting (Sentry) ----
# Set NEXT_PUBLIC_SENTRY_DSN to start receiving real error reports -- that's the only one of
# these four required for error capture itself. SENTRY_ORG/SENTRY_PROJECT/SENTRY_AUTH_TOKEN are
# only needed for source-map upload at build time (readable stack traces on sentry.io); without
# them the build still succeeds, it just uploads no source maps.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ---- Automations cron (/api/automation/process) ----
# Vercel sets this automatically for cron-triggered requests when crons are
# configured in vercel.json — no need to set it yourself on Vercel. Only
# needed for manually calling the endpoint outside the admin "Run now" button.
CRON_SECRET=

# ---- Admin auth ----
# Used to sign admin session cookies. Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=
# Seed admin login for local/demo use only — change immediately in production
# and manage real admin accounts via the admin_users table instead.
ADMIN_DEMO_EMAIL=admin@abbiescleanco.com
ADMIN_DEMO_PASSWORD=
