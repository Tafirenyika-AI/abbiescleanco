// Abbie's Clean Method LLC — database schema
//
// Provider is PostgreSQL per the project spec (works as-is with Supabase).
// Until DATABASE_URL is configured, the app's API routes fall back to a
// local JSON mock store (see src/lib/server/leadStore.ts) so the customer
// journey is fully testable without live infrastructure. Run
// `npx prisma migrate dev` once a real Postgres/Supabase URL is set.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum LeadStatus {
  NEW
  CONTACTED
  ESTIMATE_SENT
  AWAITING_CUSTOMER
  CONFIRMED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  LOST
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum BookingStatus {
  REQUESTED // customer-requested date/time, not yet approved by the business
  CONFIRMED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum RecurringInterval {
  WEEKLY
  BIWEEKLY
  EVERY_4_WEEKS
  CUSTOM
}

enum ContactMethod {
  PHONE
  EMAIL
  WHATSAPP
  SMS
}

enum MessageChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum AutomationEventType {
  NEW_LEAD
  QUOTE_FOLLOW_UP_1
  QUOTE_FOLLOW_UP_2
  BOOKING_CONFIRMATION
  REMINDER_48H
  REMINDER_24H
  REMINDER_DAY_OF
  POST_SERVICE_THANK_YOU
  REVIEW_REQUEST
  RECURRING_ENROLLMENT
  WIN_BACK
}

enum AutomationEventStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
  CANCELLED
}

// ---------- Core people & access ----------

// Fixed set of fine-grained admin permissions, ticked per user in the admin
// panel rather than inferred from a single role string. `role` stays as a
// coarse label (shown in the UI, e.g. "Owner" vs "Staff"); `permissions` is
// what actually gates access to each admin section.
enum AdminPermission {
  MANAGE_LEADS
  MANAGE_PRICING
  MANAGE_CONTENT // services, FAQs, gallery, testimonials, business settings
  MANAGE_REVIEWS
  MANAGE_BOOKINGS
  MANAGE_USERS // create/edit other admin accounts
  VIEW_REPORTS
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin") // display label, e.g. "Owner", "Staff"
  permissions  AdminPermission[] @default([])
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  resetToken           String?  @unique
  resetTokenExpiresAt  DateTime?
  twoFactorEnabled     Boolean  @default(false)
  twoFactorSecret      String? // base32 TOTP secret; set once enabled (or pending confirmation)
  twoFactorBackupCodes String[] @default([]) // bcrypt-hashed one-time recovery codes
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  auditLogs AuditLog[]

  @@index([email])
  @@map("admin_users")
}

model User {
  id                   String   @id @default(cuid())
  email                String   @unique
  name                 String?
  passwordHash         String?  // null until the customer sets a password (accounts can start as guest leads)
  resetToken           String?  @unique
  resetTokenExpiresAt  DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  deletedAt            DateTime?

  customer      Customer?
  notifications Notification[]

  @@map("users")
}

model Customer {
  id        String   @id @default(cuid())
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id])

  firstName String
  lastName  String
  email     String
  phone     String
  notes     String?
  petsNote  String?
  accessInstructions String? // never sent in email subject lines or to analytics

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  addresses               Address[]
  leads                   Lead[]
  bookings                Booking[]
  recurringSchedules      RecurringSchedule[]
  payments                Payment[]
  communicationPreference CommunicationPreference?
  messages                Message[]
  reviews                 Review[]
  attachments             Attachment[]
  clientNotes             ClientNote[]
  photoEstimates          PhotoEstimate[]

  @@index([email])
  @@index([phone])
  @@map("customers")
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  line1      String
  line2      String?
  city       String
  state      String
  zip        String
  propertyType String // apartment | house | townhome | commercial

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  leads    Lead[]
  bookings Booking[]

  @@index([zip])
  @@map("addresses")
}

// ---------- Leads & quotes ----------

model Lead {
  id           String     @id @default(cuid())
  reference    String     @unique // human-friendly lead/quote reference, e.g. ACM-24-000123

  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id])
  addressId    String?
  address      Address?   @relation(fields: [addressId], references: [id])

  status       LeadStatus @default(NEW)
  source       String     @default("website") // website | referral | google | tiktok | facebook | other
  campaign     String?    // UTM campaign, if present

  serviceId    String
  service      ServiceCatalogItem @relation(fields: [serviceId], references: [id])

  preferredContactMethod ContactMethod @default(EMAIL)
  additionalInstructions String?

  lostReason   String?
  promoCode    String? // as typed by the customer on the estimate form; validity is checked when a quote is built, not at submit time

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  quoteRequest QuoteRequest?
  quotes       Quote[]
  bookings     Booking[]
  attachments  Attachment[]
  clientNotes  ClientNote[]
  photoEstimates PhotoEstimate[]
  automationEvents AutomationEvent[]

  @@index([status])
  @@index([createdAt])
  @@map("leads")
}

model QuoteRequest {
  id     String @id @default(cuid())
  leadId String @unique
  lead   Lead   @relation(fields: [leadId], references: [id])

  propertyType   String
  squareFeet     Int
  bedrooms       Int
  bathrooms      Int
  condition      String // light | normal | heavy | very-heavy
  frequency      String // one-time | weekly | biweekly | every-4-weeks | custom
  hasPets        Boolean @default(false)
  lastProfessionalCleaning String?
  preferredDate  DateTime?
  preferredTimeWindow String?
  addOns         String[] // AddOnKey[] stored as strings
  attachments    String[] // customer-provided reference photos/videos (URLs), optional

  estimateLow    Int?
  estimateHigh   Int?
  requiresManualQuote Boolean @default(false)

  smsConsent   Boolean @default(false)
  emailConsent Boolean @default(false)

  duplicateOfId String? // set when detected as a likely duplicate submission

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("quote_requests")
}

model Quote {
  id         String      @id @default(cuid())
  quoteNumber String     @unique
  leadId     String
  lead       Lead        @relation(fields: [leadId], references: [id])

  status     QuoteStatus @default(DRAFT)
  subtotal   Int
  discount   Int         @default(0)
  tax        Int         @default(0)
  deposit    Int         @default(0)
  total      Int
  currency   String      @default("USD")
  expiresAt  DateTime?
  notes      String?

  promoCodeId String?
  promoCode   PromoCode? @relation(fields: [promoCodeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  items    QuoteItem[]
  bookings Booking[]
  payments Payment[]

  @@index([status])
  @@map("quotes")
}

model PromoCode {
  id              String    @id @default(cuid())
  code            String    @unique
  description     String?
  discountType    String    @default("PERCENT") // PERCENT | FIXED
  discountValue   Int       // percent 1-100, or cents when FIXED
  active          Boolean   @default(true)
  startsAt        DateTime?
  expiresAt       DateTime?
  maxRedemptions  Int?
  redemptionCount Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes Quote[]

  @@map("promo_codes")
}

model QuoteItem {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id])

  label     String
  quantity  Int    @default(1)
  unitPrice Int
  total     Int

  createdAt DateTime @default(now())

  @@map("quote_items")
}

// ---------- Services & pricing (admin-managed content) ----------

model ServiceCatalogItem {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   // short/teaser description
  category    String   @default("home") // home | specialty | commercial
  imageUrl    String?
  imageAlt    String?
  // Everything else that varies per service and is genuinely admin-editable
  // content (not pricing): { forWho, included: string[], addOns: string[],
  // recommendedFrequency, prepare: string[] }. Kept as JSON rather than more
  // columns since it's read as a whole object everywhere it's used.
  details     Json?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  addOns      ServiceAddon[]
  pricingRules PricingRule[]
  leads       Lead[]

  @@map("services")
}

model ServiceAddon {
  id        String @id @default(cuid())
  serviceId String
  service   ServiceCatalogItem @relation(fields: [serviceId], references: [id])

  key       String
  label     String
  priceLow  Int
  priceHigh Int
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceId, key])
  @@map("service_addons")
}

model PricingRule {
  id        String @id @default(cuid())
  serviceId String
  service   ServiceCatalogItem @relation(fields: [serviceId], references: [id])

  baseLow           Int
  baseHigh          Int
  baseBedrooms      Int @default(3)
  baseBathrooms     Int @default(2)
  baseSqFt          Int @default(1500)
  perExtraBedroom   Int @default(0)
  perExtraBathroom  Int @default(0)
  perExtraSqFt      Float @default(0)
  manualQuoteAboveSqFt Int @default(4000)
  isActive          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pricing_rules")
}

// ---------- Bookings & scheduling ----------

model Booking {
  id        String        @id @default(cuid())
  reference String        @unique

  leadId     String?
  lead       Lead?         @relation(fields: [leadId], references: [id])
  quoteId    String?
  quote      Quote?        @relation(fields: [quoteId], references: [id])
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id])
  addressId  String
  address    Address       @relation(fields: [addressId], references: [id])

  status         BookingStatus @default(REQUESTED)
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  arrivalWindow  String?
  durationMinutes Int?

  staffAssignee String? // free-text placeholder until staff accounts exist

  googleCalendarEventId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  statusHistory     BookingStatusHistory[]
  recurringSchedule RecurringSchedule? @relation(fields: [recurringScheduleId], references: [id])
  recurringScheduleId String?
  payments          Payment[]
  automationEvents  AutomationEvent[]
  attachments       Attachment[]
  clientNotes       ClientNote[]

  @@index([status])
  @@index([scheduledStart])
  @@map("bookings")
}

model BookingStatusHistory {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])

  fromStatus BookingStatus?
  toStatus   BookingStatus
  note       String?
  changedBy  String? // admin_users.id, when set programmatically

  createdAt DateTime @default(now())

  @@map("booking_status_history")
}

model RecurringSchedule {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  interval        RecurringInterval
  customRuleNote  String?
  isActive        Boolean @default(false) // future visits are created only after admin confirmation
  confirmedByAdminId String?
  nextRunAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  bookings Booking[]

  @@map("recurring_schedules")
}

// ---------- Payments ----------

model Payment {
  id        String        @id @default(cuid())
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id])
  quoteId    String?
  quote      Quote?        @relation(fields: [quoteId], references: [id])
  bookingId  String?
  booking    Booking?      @relation(fields: [bookingId], references: [id])

  status        PaymentStatus @default(PENDING)
  amount        Int
  currency      String        @default("USD")
  kind          String        @default("deposit") // deposit | full_payment
  stripePaymentIntentId String?
  proofUrl      String? // receipt/screenshot the admin attached, or the Stripe-hosted receipt URL
  method        String? // CARD | ZELLE | VENMO | APPLE_CASH | CHECK | CASH | OTHER (null on older rows)
  reference     String? // check number, Zelle/Venmo transaction id, etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("payments")
}

// ---------- Communication ----------

model CommunicationPreference {
  id         String   @id @default(cuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id])

  smsConsent      Boolean @default(false)
  emailConsent    Boolean @default(false)
  marketingConsent Boolean @default(false)
  unsubscribedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("communication_preferences")
}

model Message {
  id         String  @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  channel   MessageChannel
  templateKey String?
  subject   String?
  body      String
  toAddress String

  sentAt    DateTime?
  failedAt  DateTime?
  errorMessage String?

  createdAt DateTime @default(now())

  @@index([channel])
  @@index([customerId])
  @@map("messages")
}

model MessageTemplate {
  id       String @id @default(cuid())
  key      String @unique // e.g. "new_lead_confirmation", "booking_confirmation"
  channel  MessageChannel
  subject  String?
  body     String // supports {{variable}} interpolation
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("message_templates")
}

model AutomationEvent {
  id     String @id @default(cuid())
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id])
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])

  type      AutomationEventType
  status    AutomationEventStatus @default(PENDING)
  scheduledFor DateTime?
  processedAt  DateTime?
  payload      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status])
  @@index([scheduledFor])
  @@map("automation_events")
}

// ---------- Content & marketing ----------

model Review {
  id         String   @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  leadId     String?  // optional link to the completed job this review is about

  authorName String
  location   String?
  quote      String
  rating     Int      @default(5) // 1-5
  // A review is honest customer feedback the moment it's submitted; isPublished
  // gates whether it appears anywhere public, isFeatured gates whether it's
  // one of the small set highlighted on the homepage — curation, never editing
  // or fabricating what was said.
  isPublished Boolean @default(false)
  isFeatured  Boolean @default(false)
  source     String   @default("direct") // direct | google

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([isPublished, isFeatured])
  @@map("reviews")
}

model Faq {
  id        String  @id @default(cuid())
  question  String
  answer    String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

enum NotificationType {
  LEAD_STATUS_CHANGED
  QUOTE_READY
  BOOKING_CONFIRMED
  BOOKING_REMINDER
  REVIEW_REQUESTED
  GENERAL
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type    NotificationType @default(GENERAL)
  title   String
  body    String
  link    String? // in-app path to navigate to, e.g. "/account/quotes/ACM-26-XXXXXX"
  isRead  Boolean          @default(false)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model GalleryItem {
  id          String  @id @default(cuid())
  imageUrl    String
  altText     String
  caption     String?
  serviceType String?
  category    String?
  isBeforeAfterPair Boolean @default(false)
  pairGroupId String? // links a genuine before/after pair
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@map("gallery_items")
}

model ServiceArea {
  id       String  @id @default(cuid())
  name     String
  zipCode  String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("service_areas")
}

model BusinessSetting {
  id    String @id @default(cuid())
  key   String @unique
  value Json

  updatedAt DateTime @updatedAt

  @@map("business_settings")
}

model AuditLog {
  id          String   @id @default(cuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])

  action      String // e.g. "lead.status_changed", "quote.sent"
  entityType  String
  entityId    String
  before      Json?
  after       Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---------- Team & expenses ----------

model TeamMember {
  id             String   @id @default(cuid())
  name           String
  email          String?
  phone          String?
  role           String   @default("Cleaner") // e.g. Cleaner, Lead Cleaner, Supervisor
  qualifications String[] @default([]) // service names/slugs this person can perform
  workingHours   String?  // free-text, e.g. "Mon-Fri 8am-5pm"
  isActive       Boolean  @default(true)
  notes          String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("team_members")
}

enum ExpenseCategory {
  CLEANING_SUPPLIES
  TRANSPORTATION
  EQUIPMENT
  ADVERTISING
  SOFTWARE
  INSURANCE
  PAYROLL
  OTHER
}

model Expense {
  id              String          @id @default(cuid())
  category        ExpenseCategory
  vendor          String?
  amount          Int // cents
  date            DateTime
  description     String?
  paymentMethod   String? // cash | check | card | other
  isTaxDeductible Boolean         @default(true)
  receiptUrl      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([category])
  @@index([date])
  @@map("expenses")
}

// ---------- Admin notification center ----------
// Business-wide, not per-admin-user — a small team sees the same feed,
// and "read" is shared (marking it read clears it for everyone). That's
// a deliberate simplification, not an oversight, for a 1-3 person admin team.

enum AdminNotificationType {
  NEW_LEAD
  QUOTE_ACCEPTED
  QUOTE_DECLINED
  BOOKING_REQUESTED
  BOOKING_CANCELLED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  REVIEW_RECEIVED
  ADMIN_USER_CHANGED
  PRICING_CHANGED
  NEW_MESSAGE
  GENERAL
}

model AdminNotification {
  id     String                @id @default(cuid())
  type   AdminNotificationType @default(GENERAL)
  title  String
  body   String
  link   String?
  isRead Boolean               @default(false)

  createdAt DateTime @default(now())

  @@index([isRead])
  @@map("admin_notifications")
}

enum ContactMessageStatus {
  NEW
  READ
  RESPONDED
  ARCHIVED
}

/** Every submission through the public Contact form -- previously only emailed, never stored, so nothing survived if the email was missed. */
model ContactMessage {
  id       String               @id @default(cuid())
  name     String
  email    String
  phone    String?
  message  String
  isUrgent Boolean              @default(false)
  status   ContactMessageStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

// ---------- Client-provided detail: media, notes, photo estimates ----------

model Attachment {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  leadId     String?
  lead       Lead?    @relation(fields: [leadId], references: [id])
  bookingId  String?
  booking    Booking? @relation(fields: [bookingId], references: [id])

  kind       String   // IMAGE | VIDEO
  url        String
  mimeType   String
  sizeBytes  Int      @default(0)
  caption    String?
  uploadedBy String   @default("CUSTOMER") // CUSTOMER | STAFF

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([customerId])
  @@index([leadId])
  @@index([bookingId])
  @@map("attachments")
}

model ClientNote {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  leadId     String?
  lead       Lead?    @relation(fields: [leadId], references: [id])
  bookingId  String?
  booking    Booking? @relation(fields: [bookingId], references: [id])

  body       String
  author     String   @default("CUSTOMER") // CUSTOMER | STAFF
  authorName String?
  kind       String   @default("NOTE") // NOTE | RESCHEDULE_REQUEST | CANCELLATION | QUOTE_QUESTION | QUOTE_DECLINE

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([bookingId])
  @@map("client_notes")
}

model PhotoEstimate {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id])

  imageUrls    Json     // string[]
  areaType     String?
  analysis     Json     // structured model output (per-photo findings, supplies, notes)
  serviceId    String?
  estimateLow  Int?     // whole dollars, computed by our pricing engine (never by the model)
  estimateHigh Int?
  hoursLow     Float?
  hoursHigh    Float?
  mode         String   @default("ai") // ai | fallback

  createdAt DateTime @default(now())

  @@index([leadId])
  @@map("photo_estimates")
}
